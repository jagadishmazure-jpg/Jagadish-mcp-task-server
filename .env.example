# Copy to .env (git-ignored) only if you need these. Nothing here is required.
# OPENAI_API_KEY=            # optional; without it the offline fake model is used
# OPENAI_MODEL=gpt-4o-mini
# MCP_AUTH_TOKEN=            # optional; turns on bearer-token auth for HTTP
# MCP_HOST=127.0.0.1         # change only if you understand the exposure
# MCP_PORT=8000
# TASKS_DB_PATH=tasks.db
